<Application x:Class="CodexThemeStudio.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CodexThemeStudio.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/ComponentStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:CssColorBrushConverter x:Key="CssColorBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
