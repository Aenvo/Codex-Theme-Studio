<UserControl x:Class="CodexThemeStudio.Desktop.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodexThemeStudio.Desktop.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="52">
    <UserControl.Resources>
        <Style x:Key="HistorySwatchButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorFieldOpenButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InputBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen, ElementName=PickerPopup}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColorChannelSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,3,0,7" />
            <Setter Property="local:SliderJumpBehavior.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18">
                            <Border Height="12" VerticalAlignment="Center" CornerRadius="6"
                                    Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" />
                            <Track x:Name="PART_Track" Height="18"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                            <RepeatButton Opacity="0" Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource PrimaryForegroundBrush}"
                                                         Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                            <RepeatButton Opacity="0" Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="1,0,0,5" Foreground="{DynamicResource MutedForegroundBrush}"
                   FontSize="12" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Button x:Name="OpenButton" Grid.Row="1" Margin="0" Padding="9,7"
                Style="{StaticResource ColorFieldOpenButtonStyle}"
                HorizontalContentAlignment="Stretch" Click="OnOpenClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" Background="{DynamicResource CheckerboardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border x:Name="ColorChip" CornerRadius="4" />
                </Border>
                <TextBlock x:Name="ValueText" Grid.Column="1" Margin="9,0,0,0"
                           VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock x:Name="AlphaText" Grid.Column="2" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
            </Grid>
        </Button>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom" HorizontalOffset="0" VerticalOffset="6"
               AllowsTransparency="True" StaysOpen="False"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border Width="316" Padding="12" Style="{DynamicResource PopupChromeStyle}"
                    Background="{DynamicResource PopoverBrush}">
                <Grid PreviewKeyDown="OnPopupPreviewKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="148" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Text="选择颜色" />
                    </DockPanel>

                    <Grid x:Name="SaturationValueSurface" Grid.Row="1" ClipToBounds="True"
                          Cursor="Cross" MouseLeftButtonDown="OnSaturationValueMouse"
                          MouseMove="OnSaturationValueMouse" MouseLeftButtonUp="OnSaturationValueMouseUp">
                        <Border x:Name="HueSurface" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop x:Name="HueGradientStop" Color="Red" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SelectionMarker" Width="16" Height="16"
                                     Stroke="White" StrokeThickness="3" Fill="Transparent" />
                        </Canvas>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,11,0,0">
                        <Slider x:Name="HueSlider" Style="{StaticResource ColorChannelSliderStyle}"
                                Minimum="0" Maximum="360" ValueChanged="OnHueChanged"
                                PreviewMouseLeftButtonUp="OnChannelMouseUp">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFF0000" Offset="0" />
                                    <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                    <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                    <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                    <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FFFF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <Slider x:Name="SaturationSlider" Style="{StaticResource ColorChannelSliderStyle}"
                                Minimum="0" Maximum="1" ValueChanged="OnSaturationChanged"
                                PreviewMouseLeftButtonUp="OnChannelMouseUp">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop x:Name="SaturationStartGradientStop" Color="Gray" Offset="0" />
                                    <GradientStop x:Name="SaturationEndGradientStop" Color="Red" Offset="1" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <Border Margin="0,3,0,0" Background="{DynamicResource CheckerboardBrush}" CornerRadius="6">
                            <Slider x:Name="AlphaSlider" Style="{StaticResource ColorChannelSliderStyle}"
                                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0" ValueChanged="OnAlphaChanged"
                                    PreviewMouseLeftButtonUp="OnChannelMouseUp" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="FormatSelector" SelectedIndex="0"
                                  SelectionChanged="OnFormatSelectionChanged"
                                  AutomationProperties.Name="颜色格式">
                            <ComboBoxItem Content="Hex" />
                            <ComboBoxItem Content="RGB" />
                            <ComboBoxItem Content="CSS" />
                        </ComboBox>
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid x:Name="HexInputs">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HexInput" FontFamily="Consolas" TextChanged="OnHexTextChanged"
                                         GotKeyboardFocus="OnValueInputGotKeyboardFocus"
                                         PreviewMouseDown="OnValueInputPreviewMouseDown"
                                         LostKeyboardFocus="OnValueInputLostKeyboardFocus" />
                                <TextBox x:Name="HexOpacityInput" Grid.Column="1" FontFamily="Consolas"
                                         TextAlignment="Right" TextChanged="OnHexOpacityTextChanged"
                                         GotKeyboardFocus="OnValueInputGotKeyboardFocus"
                                         PreviewMouseDown="OnValueInputPreviewMouseDown"
                                         LostKeyboardFocus="OnValueInputLostKeyboardFocus" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="%" />
                            </Grid>
                            <Grid x:Name="RgbInputs" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RedInput" TextChanged="OnRgbTextChanged" GotKeyboardFocus="OnValueInputGotKeyboardFocus" PreviewMouseDown="OnValueInputPreviewMouseDown" LostKeyboardFocus="OnValueInputLostKeyboardFocus" />
                                <TextBox x:Name="GreenInput" Grid.Column="1" TextChanged="OnRgbTextChanged" GotKeyboardFocus="OnValueInputGotKeyboardFocus" PreviewMouseDown="OnValueInputPreviewMouseDown" LostKeyboardFocus="OnValueInputLostKeyboardFocus" />
                                <TextBox x:Name="BlueInput" Grid.Column="2" TextChanged="OnRgbTextChanged" GotKeyboardFocus="OnValueInputGotKeyboardFocus" PreviewMouseDown="OnValueInputPreviewMouseDown" LostKeyboardFocus="OnValueInputLostKeyboardFocus" />
                                <TextBox x:Name="AlphaPercentInput" Grid.Column="3" TextChanged="OnRgbTextChanged" GotKeyboardFocus="OnValueInputGotKeyboardFocus" PreviewMouseDown="OnValueInputPreviewMouseDown" LostKeyboardFocus="OnValueInputLostKeyboardFocus" />
                            </Grid>
                            <TextBox x:Name="CssInput" Visibility="Collapsed" FontFamily="Consolas"
                                     TextChanged="OnCssTextChanged" GotKeyboardFocus="OnValueInputGotKeyboardFocus"
                                     PreviewMouseDown="OnValueInputPreviewMouseDown"
                                     LostKeyboardFocus="OnValueInputLostKeyboardFocus" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <ItemsControl x:Name="HistoryPalette"
                                      ItemsSource="{Binding ColorHistory, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="22" Height="22" Margin="0,0,5,5" Tag="{Binding}"
                                            Style="{StaticResource HistorySwatchButtonStyle}"
                                            Click="OnSwatchClick" ToolTip="{Binding}">
                                        <Border Background="{DynamicResource CheckerboardBrush}" CornerRadius="2">
                                            <Border Background="{Binding Converter={StaticResource CssColorBrushConverter}}" CornerRadius="1" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
