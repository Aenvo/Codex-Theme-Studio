<UserControl x:Class="CodexThemeStudio.Desktop.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="52">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="1,0,0,5" Foreground="{DynamicResource MutedForegroundBrush}"
                   FontSize="12" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Button x:Name="OpenButton" Grid.Row="1" Margin="0" Padding="9,7"
                HorizontalContentAlignment="Stretch" Click="OnOpenClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" Background="{DynamicResource CheckerboardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Border x:Name="ColorChip" CornerRadius="4" />
                </Border>
                <TextBlock x:Name="ValueText" Grid.Column="1" Margin="9,0,0,0"
                           VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock x:Name="AlphaText" Grid.Column="2" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
            </Grid>
        </Button>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom" HorizontalOffset="0" VerticalOffset="6"
               AllowsTransparency="True" StaysOpen="False"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border Width="314" Padding="14" Style="{DynamicResource PopupChromeStyle}"
                    Background="{DynamicResource PopoverBrush}">
                <Grid PreviewKeyDown="OnPopupPreviewKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Text="选择颜色" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="CSS RGBA" />
                    </DockPanel>

                    <Grid x:Name="SaturationValueSurface" Grid.Row="1" ClipToBounds="True"
                          Cursor="Cross" MouseLeftButtonDown="OnSaturationValueMouse"
                          MouseMove="OnSaturationValueMouse" MouseLeftButtonUp="OnSaturationValueMouseUp">
                        <Border x:Name="HueSurface" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop x:Name="HueGradientStop" Color="Red" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SelectionMarker" Width="16" Height="16"
                                     Stroke="White" StrokeThickness="2" Fill="Transparent" />
                        </Canvas>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,11,0,0">
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="色相" />
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Margin="0,3,0,7"
                                ValueChanged="OnHueChanged">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFF0000" Offset="0" />
                                    <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                    <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                    <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                    <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FFFF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <DockPanel>
                            <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="透明度" />
                            <TextBlock x:Name="AlphaPopupText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" />
                        </DockPanel>
                        <Border Margin="0,3,0,0" Background="{DynamicResource CheckerboardBrush}" CornerRadius="4">
                            <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" Margin="0"
                                    ValueChanged="OnAlphaChanged" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,7,0" Background="{DynamicResource CheckerboardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Border x:Name="OriginalPreview" CornerRadius="5" />
                        </Border>
                        <Border Grid.Column="1" Margin="0,0,7,0" Background="{DynamicResource CheckerboardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Border x:Name="CurrentPreview" CornerRadius="5" />
                        </Border>
                        <TextBox x:Name="HexInput" Grid.Column="2" FontFamily="Consolas"
                                 TextChanged="OnHexTextChanged" />
                    </Grid>

                    <ItemsControl x:Name="ThemePalette" Grid.Row="4" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="28" Height="28" Margin="0,0,6,6" Padding="3"
                                        Tag="{Binding}" Click="OnSwatchClick" ToolTip="{Binding}">
                                    <Border Background="{DynamicResource CheckerboardBrush}" CornerRadius="5">
                                        <Border Background="{Binding Converter={StaticResource CssColorBrushConverter}}"
                                                CornerRadius="4" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="5" Margin="0,2,0,0" FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="格式：#RRGGBB 或 #RRGGBBAA" />

                    <StackPanel Grid.Row="6" Margin="0,12,0,0" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{DynamicResource GhostButtonStyle}" Content="取消" Click="OnCancelClick" />
                        <Button Style="{DynamicResource PrimaryButtonStyle}" Margin="0"
                                Content="应用" Click="OnApplyClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
