<Window x:Class="CodexThemeStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodexThemeStudio.Desktop.ViewModels"
        xmlns:controls="clr-namespace:CodexThemeStudio.Desktop.Controls"
        xmlns:models="clr-namespace:CodexThemeStudio.Contracts.Models;assembly=CodexThemeStudio.Contracts"
        mc:Ignorable="d"
        Title="Codex Theme Studio"
        Icon="/CodexThemeStudio.Desktop;component/Assets/app-icon.png"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="EditorOverlayScrollBarStyle"
               TargetType="ScrollBar"
               BasedOn="{StaticResource ScrollBarBaseStyle}">
            <Setter Property="Width" Value="3" />
            <Setter Property="MinWidth" Value="3" />
            <Setter Property="MaxWidth" Value="3" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="0.5"
                                                        Background="#99FFFFFF"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                             Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorOverlayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Margin="0,6,1,6"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource EditorOverlayScrollBarStyle}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageUploadButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BusySegmentCellStyle" TargetType="Border">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Opacity" Value="0.18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SegmentedBusyProgressStyle" TargetType="ProgressBar">
            <Setter Property="MinWidth" Value="83" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <UniformGrid Columns="24" VerticalAlignment="Center">
                            <Border x:Name="BusySegmentOne" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTwo" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentThree" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentFour" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentFive" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentSix" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentSeven" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentEight" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentNine" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentEleven" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTwelve" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentThirteen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentFourteen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentFifteen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentSixteen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentSeventeen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentEighteen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentNineteen" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTwenty" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTwentyOne" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTwentyTwo" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTwentyThree" Style="{StaticResource BusySegmentCellStyle}" />
                            <Border x:Name="BusySegmentTwentyFour" Style="{StaticResource BusySegmentCellStyle}" />
                        </UniformGrid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentOne"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTwo"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.08"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentThree"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.16"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentFour"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.24"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentFive"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.32"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentSix"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.40"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentSeven"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.48"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentEight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.56"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentNine"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.64"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.72"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentEleven"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.80"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTwelve"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.88"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentThirteen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:0.96"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentFourteen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.04"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentFifteen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.12"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentSixteen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.20"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentSeventeen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.28"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentEighteen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.36"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentNineteen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.44"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTwenty"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.52"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTwentyOne"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.60"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTwentyTwo"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.68"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTwentyThree"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.76"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="BusySegmentTwentyFour"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="1"
                                                             BeginTime="0:0:1.84"
                                                             Duration="0:0:0.24"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorPreviewModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14,7" />
        </Style>

        <Style x:Key="HomePreviewModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorPreviewModeButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor.IsTaskPreview}" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskPreviewModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorPreviewModeButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor.IsTaskPreview}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background"
                                        Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background"
                                        Value="{DynamicResource SidebarAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavigationChrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:LibraryPage.Current}">
                    <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:LibraryPage.All}">
                    <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:LibraryPage.Import}">
                    <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:LibraryPage.Editor}">
                    <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoritesNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:LibraryPage.Favorites}">
                    <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrashNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:LibraryPage.Trash}">
                    <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:LibraryPage.Settings}">
                    <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillStyle" TargetType="Border" BasedOn="{StaticResource BadgeStyle}" />

        <Style x:Key="ThemeStatusTabStyle"
               TargetType="Border"
               BasedOn="{StaticResource BadgeStyle}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="LayoutSegmentKeyboardFocusStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource RingBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayoutSegmentButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource LayoutSegmentKeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SegmentChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentChrome" Property="Background"
                                        Value="{DynamicResource SecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentChrome" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left"
                                    Padding="4"
                                    Background="{DynamicResource MutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TabPanel IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="0,20,0,0"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome"
                                        Property="Background"
                                        Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome"
                                        Property="Background"
                                        Value="{DynamicResource InputBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource RingBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabChrome"
                                        Property="BorderBrush"
                                        Value="Transparent" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorColorResetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeFavoriteButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="ToolTip" Value="收藏" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FavoriteChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Viewbox Width="18" Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path x:Name="FavoriteIcon"
                                      Width="24" Height="24"
                                      Data="{StaticResource LucideStarGeometry}"
                                      Fill="Transparent"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FavoriteChrome" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FavoriteChrome" Property="Background" Value="#52FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FavoriteChrome" Property="BorderBrush"
                                        Value="{DynamicResource RingBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FavoriteIcon" Property="Fill" Value="#FACC15" />
                                <Setter TargetName="FavoriteIcon" Property="Stroke" Value="#FACC15" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FavoriteChrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="取消收藏" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Card"
                                    Margin="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="CardOutline"
                                    Panel.ZIndex="1"
                                    Margin="1"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardOutline" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="CardOutline" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CardOutline" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CardOutline" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ListChrome"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ListChrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ListChrome" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ListChrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ListChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ListChrome" Property="BorderBrush"
                                        Value="{DynamicResource RingBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="ApplicationSurface"
              AutomationProperties.Name="应用主布局">
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="240" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditorVisible}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                Padding="16,22"
                AutomationProperties.Name="应用侧栏">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="36"
                               Height="36"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Source="/CodexThemeStudio.Desktop;component/Assets/app-icon.png"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               AutomationProperties.Name="Codex Theme Studio 产品图标" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Codex Theme Studio" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Text="Codex 主题配置工作台" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource WorkspaceNavigationButtonStyle}"
                             Foreground="White"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="All"
                             AutomationProperties.Name="工作台">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LucideIconStyle}"
                                            Content="{StaticResource LucideLayoutGridGeometry}" />
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Foreground="White"
                                       Text="工作台" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FavoritesNavigationButtonStyle}"
                             Foreground="White"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="Favorites"
                             AutomationProperties.Name="收藏">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LucideIconStyle}"
                                            Content="{StaticResource LucideStarGeometry}" />
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Foreground="White"
                                       Text="收藏" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TrashNavigationButtonStyle}"
                             Foreground="White"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="Trash"
                             AutomationProperties.Name="回收站">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LucideIconStyle}"
                                            Content="{StaticResource LucideTrash2Geometry}" />
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Foreground="White"
                                       Text="回收站" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom"
                            VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SettingsNavigationButtonStyle}"
                             Foreground="White"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="Settings"
                             AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LucideIconStyle}"
                                            Content="{StaticResource LucideSettingsGeometry}" />
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Foreground="White"
                                       Text="设置" />
                        </StackPanel>
                    </Button>
                    <Border Margin="0,14,0,0"
                            Padding="12"
                            Background="{DynamicResource SecondaryBrush}"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="11"
                                       Text="当前选择" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedThemeName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedThemeName}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1"
                    Margin="0,0,0,0"
                    Padding="14,11"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="10"
                    Opacity="0.94"
                    AutomationProperties.Name="所选主题状态">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLibraryVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"
                                AutomationProperties.Name="ChatGPT Codex 检测状态">
                        <StackPanel Orientation="Horizontal">
                        <ContentControl Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        Foreground="{DynamicResource LoadingBrush}"
                                        RenderTransformOrigin="0.5,0.5"
                                        Content="{StaticResource LucideRefreshCwGeometry}">
                            <ContentControl.RenderTransform>
                                <RotateTransform />
                            </ContentControl.RenderTransform>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl"
                                       BasedOn="{StaticResource LucideIconStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCodexStatusConfirming}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="CodexStatusLoadingSpin">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                         From="0"
                                                                         To="360"
                                                                         Duration="0:0:0.8" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="CodexStatusLoadingSpin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCodexDetected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CodexStatusPhase}" Value="{x:Static vm:CodexDetectionPhase.Cached}">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CodexStatusPhase}" Value="{x:Static vm:CodexDetectionPhase.Confirming}">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CodexStatusPhase}" Value="{x:Static vm:CodexDetectionPhase.Error}">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCodexStatusConfirming}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding CodexStatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCodexDetected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CodexStatusPhase}" Value="{x:Static vm:CodexDetectionPhase.Cached}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CodexStatusPhase}" Value="{x:Static vm:CodexDetectionPhase.Confirming}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CodexStatusPhase}" Value="{x:Static vm:CodexDetectionPhase.Error}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCodexStatusConfirming}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource LoadingBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>
                        <TextBlock Margin="16,3,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   FontSize="11"
                                   Text="{Binding CodexCompatibilityText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1"
                                 Margin="16,0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource SegmentedBusyProgressStyle}"
                                 IsIndeterminate="True"
                                 AutomationProperties.Name="主题应用进度" />
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplyTemporaryCommand}" Content="临时应用" />
                        <Button Command="{Binding SetPersistentCommand}" Content="设为持久主题"
                                ToolTip="{Binding PersistenceEligibilityMessage}" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RestoreCommand}" Content="还原外观" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="27"
                                   FontWeight="SemiBold"
                                   Text="{Binding PageTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding ThemeCountText}" />
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RestoreCommand}"
                                Content="还原默认外观"
                                AutomationProperties.Name="还原默认外观" />
                        <Button Command="{Binding ImportCommand}"
                                AutomationProperties.Name="导入主题">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource LucideIconStyle}"
                                                Content="{StaticResource LucideImportGeometry}" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="导入主题" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CreateCommand}"
                                AutomationProperties.Name="新建主题">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource LucideIconStyle}"
                                                Content="{StaticResource LucidePlusGeometry}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="新建主题" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,22,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Margin="0,0,12,0"
                             Tag="搜索名称或标签"
                             AutomationProperties.Name="搜索主题"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称或标签搜索（Ctrl+F）" />
                    <ComboBox Grid.Column="1"
                               Margin="0,0,12,0"
                               AutomationProperties.Name="主题范围"
                               ItemsSource="{Binding ScopeOptions}"
                               SelectedItem="{Binding SelectedScope}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="全部主题" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static vm:ThemeScope.Current}">
                                                    <Setter Property="Text" Value="当前主题" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="2"
                               Margin="0,0,12,0"
                               AutomationProperties.Name="标签筛选"
                               ItemsSource="{Binding AvailableTags}"
                               SelectedItem="{Binding SelectedTag}" />
                    <ComboBox Grid.Column="3"
                               AutomationProperties.Name="排序方式"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="最近修改" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static vm:ThemeSort.Name}">
                                                    <Setter Property="Text" Value="名称" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static vm:ThemeSort.RecentlyUsed}">
                                                    <Setter Property="Text" Value="最近使用" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static vm:ThemeSort.FavoritesFirst}">
                                                    <Setter Property="Text" Value="收藏优先" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Margin="0,0,12,0">
                        <Button Command="{Binding EditCommand}"
                                AutomationProperties.Name="编辑">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource LucideIconStyle}"
                                                Content="{StaticResource LucideSettingsGeometry}" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="编辑" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyCommand}" Content="创建副本" />
                        <Button Command="{Binding RenameCommand}" Content="重命名" />
                        <Button Command="{Binding ExportCommand}" Content="导出 .cttheme" />
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteCommand}"
                                Content="移入回收站" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
