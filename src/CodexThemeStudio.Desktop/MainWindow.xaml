                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ContentControl Width="22" Height="22"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                            Style="{StaticResource LucideIconStyle}"
                                                            Content="{StaticResource LucideImageOffGeometry}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       Text="等待背景图片" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="4,5,18,5"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding TagsText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   FontSize="11"
                                                   Text="{Binding SourceText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,4,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="已移入回收站" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeCountText}" Value="0 个已删除主题">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ContentControl Width="40" Height="40"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                        Style="{StaticResource LucideIconStyle}"
                                        Content="{StaticResource LucideTrash2Geometry}" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="回收站是空的" />
                        <TextBlock Margin="0,7,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="删除的主题会保留在这里，可选择还原或永久删除。" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Height="32"
                           Margin="0,0,0,12"
                           LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                AutomationProperties.Name="编辑器面包屑">
                        <Button MinHeight="0"
                                Margin="0"
                                Padding="5,3"
                                Style="{StaticResource BreadcrumbButtonStyle}"
                                Command="{Binding CancelDraftCommand}"
                                ToolTip="返回主题资料库"
                                AutomationProperties.Name="返回主题资料库">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Style="{StaticResource LucideIconStyle}"
                                                Content="{StaticResource LucideLayoutGridGeometry}" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontSize="12"
                                           Text="主题资料库" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="9,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="/" />
                        <TextBlock MaxWidth="260"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding Editor.Name}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Editor.Name}" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12,12,2,12"
                            Background="#0CFFFFFF"
                            CornerRadius="12">
                        <ScrollViewer x:Name="EditorScrollViewer"
                                      Style="{StaticResource EditorOverlayScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      controls:EditorScrollLockBehavior.IsLocked="{Binding Editor.IsColorPickerOpen}"
                                      AutomationProperties.Name="编辑面板滚动区域">
                            <StackPanel Margin="0,0,10,0">
                            <TextBlock FontWeight="SemiBold" Text="基本信息" />
                            <TextBlock Margin="0,10,0,4" Text="主题名称" />
                            <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    AllowDrop="True"
                                    Drop="OnEditorImageDrop"
                                    DragOver="OnEditorImageDragOver"
                                    CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource MutedForegroundBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="背景图片" />
                                    <Button Height="118"
                                            Margin="0,10,0,0"
                                            Padding="0"
                                            Style="{StaticResource ImageUploadButtonStyle}"
                                            Command="{Binding SelectImageCommand}"
                                            AutomationProperties.Name="上传背景图片">
                                        <Grid>
                                            <Image Source="{Binding Editor.PreviewImagePath}"
                                                   Stretch="Uniform" />
                                            <Border IsHitTestVisible="False"
                                                    AutomationProperties.Name="背景图片上传遮罩">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Editor.HasPreviewImage}" Value="True" />
                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Opacity" Value="1" />
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0"
                                                                                             To="1"
                                                                                             Duration="0:0:0.18" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid ClipToBounds="True">
                                                    <Image Source="{Binding Editor.PreviewImagePath}"
                                                           Stretch="Uniform">
                                                        <Image.Effect>
                                                            <BlurEffect Radius="6" />
                                                        </Image.Effect>
                                                    </Image>
                                                    <Rectangle Fill="#66000000" />
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <ContentControl Width="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Center"
                                                                        Foreground="{DynamicResource ForegroundBrush}"
                                                                        Style="{StaticResource LucideIconStyle}"
                                                                        Content="{StaticResource LucideUploadGeometry}" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   Text="拖拽或上传图片" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   FontSize="11"
                                                                   Text="支持 PNG / JPEG / WebP 格式" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Editor.HasPreviewImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ContentControl Width="20"
                                                                Height="20"
                                                                HorizontalAlignment="Center"
                                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                                Style="{StaticResource LucideIconStyle}"
                                                                Content="{StaticResource LucideUploadGeometry}" />
                                                <TextBlock Margin="0,8,0,0"
                                                           HorizontalAlignment="Center"
                                                           Text="拖拽或上传图片" />
                                                <TextBlock Margin="0,4,0,0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="支持 PNG / JPEG / WebP 格式" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,16,0,8" FontWeight="SemiBold" Text="构图与显示" />
                            <TextBlock Margin="0,0,0,4" Text="图片适配" />
                            <ComboBox ItemsSource="{Binding Editor.ArtSizes}"
                                      SelectedItem="{Binding Editor.ArtSize}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="铺满（cover）" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static models:ThemeArtSize.Contain}">
                                                            <Setter Property="Text" Value="完整显示（contain）" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static models:ThemeArtSize.Crop}">
                                                            <Setter Property="Text" Value="裁切（crop）" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Editor.IsCropMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Editor.CropScale, StringFormat=图片放缩：{0:P0}}" />
                                <Slider Minimum="1" Maximum="3" SmallChange="0.01"
                                        AutomationProperties.Name="裁切图片放缩"
                                        Value="{Binding Editor.CropScale}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding Editor.FocusX, StringFormat=水平位置：{0:P1}}" />
                                <Slider Minimum="0" Maximum="1" SmallChange="0.001"
                                        AutomationProperties.Name="裁切水平位置"
                                        Value="{Binding Editor.FocusX}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding Editor.FocusY, StringFormat=垂直位置：{0:P1}}" />
                                <Slider Minimum="0" Maximum="1" SmallChange="0.001"
                                        AutomationProperties.Name="裁切垂直位置"
                                        Value="{Binding Editor.FocusY}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding Editor.HomeOpacity, StringFormat=首页透明度：{0:P0}}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Editor.HomeOpacity}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding Editor.HomeOverlay, StringFormat=首页遮罩：{0:P0}}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Editor.HomeOverlay}" />
                            <TextBlock Margin="0,8,0,4" Text="任务页模式" />
                            <ComboBox ItemsSource="{Binding Editor.TaskModes}"
                                      SelectedItem="{Binding Editor.TaskMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="弱化背景" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static models:ThemeTaskMode.Hidden}">
                                                            <Setter Property="Text" Value="隐藏背景" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static models:ThemeTaskMode.Full}">
                                                            <Setter Property="Text" Value="完整背景" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding Editor.TaskOpacity, StringFormat=任务页透明度：{0:P0}}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Editor.TaskOpacity}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding Editor.TaskOverlay, StringFormat=任务内容区遮罩深度：{0:P0}}" />
                            <Slider Minimum="0" Maximum="1"
                                    SmallChange="0.01"
                                    LargeChange="0.1"
                                    AutomationProperties.Name="任务内容区遮罩深度"
                                    IsEnabled="{Binding Editor.IsTaskOverlayEnabled}"
                                    Value="{Binding Editor.TaskOverlay}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding Editor.Blur, StringFormat=图片模糊效果：{0:F0} px}" />
                            <Slider Minimum="0" Maximum="64" Value="{Binding Editor.Blur}" />

                            <Grid Margin="0,12,0,4">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="颜色" />
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource EditorColorResetButtonStyle}"
                                        Command="{Binding Editor.ResetDefaultsCommand}"
                                        ToolTip="恢复主题默认颜色"
                                        AutomationProperties.Name="恢复主题默认颜色">
                                    <ContentControl Width="14"
                                                    Height="14"
                                                    Style="{StaticResource LucideIconStyle}"
                                                    Content="{StaticResource LucideRotateCcwGeometry}" />
                                </Button>
                            </Grid>
                            <UniformGrid Columns="2">
                                <controls:ColorField Margin="0,0,6,10" Label="背景"
                                    ColorHistory="{Binding Editor.ColorHistory}"
                                    ColorHistoryService="{Binding Editor.ColorHistoryService}"
                                    IsPickerOpen="{Binding Editor.IsColorPickerOpen, Mode=TwoWay}"
                                    Value="{Binding Editor.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <controls:ColorField Margin="6,0,0,10" Label="面板"
                                    ColorHistory="{Binding Editor.ColorHistory}"
                                    ColorHistoryService="{Binding Editor.ColorHistoryService}"
                                    IsPickerOpen="{Binding Editor.IsColorPickerOpen, Mode=TwoWay}"
                                    Value="{Binding Editor.PanelColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <controls:ColorField Margin="0,0,6,10" Label="强调"
                                    ColorHistory="{Binding Editor.ColorHistory}"
                                    ColorHistoryService="{Binding Editor.ColorHistoryService}"
                                    IsPickerOpen="{Binding Editor.IsColorPickerOpen, Mode=TwoWay}"
                                    Value="{Binding Editor.AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <controls:ColorField Margin="6,0,0,10" Label="正文"
                                    ColorHistory="{Binding Editor.ColorHistory}"
                                    ColorHistoryService="{Binding Editor.ColorHistoryService}"
                                    IsPickerOpen="{Binding Editor.IsColorPickerOpen, Mode=TwoWay}"
                                    Value="{Binding Editor.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <controls:ColorField Margin="0,0,6,10" Label="弱化文字"
                                    ColorHistory="{Binding Editor.ColorHistory}"
                                    ColorHistoryService="{Binding Editor.ColorHistoryService}"
                                    IsPickerOpen="{Binding Editor.IsColorPickerOpen, Mode=TwoWay}"
                                    Value="{Binding Editor.MutedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <controls:ColorField Margin="6,0,0,10" Label="边框"
                                    ColorHistory="{Binding Editor.ColorHistory}"
                                    ColorHistoryService="{Binding Editor.ColorHistoryService}"
                                    IsPickerOpen="{Binding Editor.IsColorPickerOpen, Mode=TwoWay}"
                                    Value="{Binding Editor.BorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </UniformGrid>
                            <TextBlock Margin="0,0,0,4"
                                       Text="{Binding Editor.PanelBlur, StringFormat=面板毛玻璃效果：{0:F0} px}" />
                            <Slider Minimum="0" Maximum="64"
                                    AutomationProperties.Name="面板毛玻璃效果"
                                    Value="{Binding Editor.PanelBlur}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="2"
                          AutomationProperties.Name="模拟预览区域">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0"
                                   Margin="0,0,0,10"
                                   AutomationProperties.Name="模拟预览工具栏">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button Style="{StaticResource HomePreviewModeButtonStyle}"
                                            Command="{Binding Editor.ShowHomePreviewCommand}"
                                            Content="首页预览" />
                                    <Button Style="{StaticResource TaskPreviewModeButtonStyle}"
                                            Command="{Binding Editor.ShowTaskPreviewCommand}"
                                            Content="任务页预览" />
                                </WrapPanel>
                            </DockPanel>
                            <Border Grid.Row="1"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Background="{Binding Editor.BackgroundColor, Converter={StaticResource CssColorBrushConverter}}"
                                     BorderBrush="{Binding Editor.BorderColor, Converter={StaticResource CssColorBrushConverter}}"
                                     BorderThickness="1"
                                     CornerRadius="14"
                                     AutomationProperties.Name="模拟预览"
                                     ClipToBounds="True">
                                <Grid x:Name="PreviewArtSurface"
                                      AutomationProperties.Name="模拟预览画布">
                                    <Canvas x:Name="PreviewImageViewport"
                                            ClipToBounds="True"
                                            IsHitTestVisible="False">
                                        <Image x:Name="PreviewBackgroundImage"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               AutomationProperties.Name="模拟预览背景图"
                                               Source="{Binding Editor.PreviewImagePath, NotifyOnTargetUpdated=True}"
                                               Stretch="Fill"
                                               TargetUpdated="OnPreviewImageTargetUpdated"
                                               Opacity="{Binding Editor.PreviewOpacity}">
                                            <Image.Effect>
                                                <BlurEffect Radius="{Binding Editor.Blur}" />
                                            </Image.Effect>
                                        </Image>
                                    </Canvas>
                                    <Border Background="{Binding Editor.BackgroundColor, Converter={StaticResource CssColorBrushConverter}}"
                                            Opacity="{Binding Editor.PreviewOverlay}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{Binding Editor.PanelColor, Converter={StaticResource CssColorBrushConverter}}"
                                                BorderBrush="{Binding Editor.BorderColor, Converter={StaticResource CssColorBrushConverter}}"
                                                BorderThickness="0,0,1,0"
                                                Opacity="0.9"
                                                AutomationProperties.Name="模拟预览侧栏">
                                            <Grid Margin="12,14,10,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Rectangle IsHitTestVisible="False"
                                                           Opacity="{Binding Editor.PanelGlassOpacity}">
                                                    <Rectangle.Fill>
                                                        <VisualBrush Visual="{Binding ElementName=PreviewBackgroundImage}"
                                                                     Stretch="UniformToFill" />
                                                    </Rectangle.Fill>
                                                    <Rectangle.Effect>
                                                        <BlurEffect Radius="{Binding Editor.PanelBlur}" />
                                                    </Rectangle.Effect>
                                                </Rectangle>
                                                <DockPanel>
                                                    <TextBlock Foreground="{Binding Editor.TextColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="Codex" />
                                                    <TextBlock Margin="5,2,0,0"
                                                               Foreground="{Binding Editor.MutedColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="9"
                                                               Text="⌄" />
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Foreground="{Binding Editor.MutedColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="13"
                                                               Text="⌕" />
                                                </DockPanel>
                                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                    <TextBlock Foreground="{Binding Editor.TextColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="10"
                                                               Text="＋  新建任务" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               Foreground="{Binding Editor.TextColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="10"
                                                               Text="⑂  拉取请求" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               Foreground="{Binding Editor.TextColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="10"
                                                               Text="▦  站点" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               Foreground="{Binding Editor.TextColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="10"
                                                               Text="◷  已安排" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               Foreground="{Binding Editor.TextColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="10"
                                                               Text="◎  插件" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                                                    <TextBlock Foreground="{Binding Editor.MutedColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="9"
                                                               Text="置顶  ›" />
                                                    <TextBlock Margin="0,14,0,0"
                                                               Foreground="{Binding Editor.MutedColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="9"
                                                               Text="项目  ›" />
                                                    <Border Margin="-5,10,-2,0"
                                                            Padding="5,6"
                                                            CornerRadius="5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Editor.IsTaskPreview}" Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{Binding Editor.BorderColor, Converter={StaticResource CssColorBrushConverter}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Foreground="{Binding Editor.MutedColor, Converter={StaticResource CssColorBrushConverter}}"
                                                                   FontSize="9"
                                                                   Text="示例任务" />
                                                    </Border>
                                                    <TextBlock Margin="0,10,0,0"
                                                               Foreground="{Binding Editor.MutedColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="9"
                                                               Text="最近  ›" />
                                                </StackPanel>
                                                <DockPanel Grid.Row="3">
                                                    <Border Width="20"
                                                            Height="20"
                                                            Background="{Binding Editor.AccentColor, Converter={StaticResource CssColorBrushConverter}}"
                                                            CornerRadius="10">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="White"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Text="LP" />
                                                    </Border>
                                                    <TextBlock Margin="7,3,0,0"
                                                               Foreground="{Binding Editor.TextColor, Converter={StaticResource CssColorBrushConverter}}"
                                                               FontSize="9"
                                                               Text="本地预览" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.RowSpan="2"
                                                    AutomationProperties.Name="任务内容区遮罩预览"
                                                    Background="{Binding Editor.BackgroundColor, Converter={StaticResource CssColorBrushConverter}}"
                                                    IsHitTestVisible="False"
                                                    Opacity="{Binding Editor.TaskContentOverlay}" />
