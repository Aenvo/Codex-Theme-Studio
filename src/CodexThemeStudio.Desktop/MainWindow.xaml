                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Text="Codex Theme Studio" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource RingBrush}"
                                                           Text="{Binding AppVersion, StringFormat=版本 {0}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    MinWidth="112"
                                                    Margin="16,0,0,0"
                                                    Command="{Binding OpenGitHubRepositoryCommand}"
                                                    ToolTip="在默认浏览器中打开 GitHub 仓库"
                                                    AutomationProperties.Name="打开 GitHub 仓库">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <ContentControl Style="{StaticResource LucideIconStyle}"
                                                                    Content="{StaticResource LucideGithubGeometry}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="GitHub" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock Margin="0,18,0,0"
                                                   Text="Windows 本地主题管理器"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="非 OpenAI 官方产品。应用默认离线运行，不自动上传主题、日志或诊断材料。" />
                                        <Border Margin="0,20,0,18"
                                                Height="1"
                                                Background="{DynamicResource BorderBrush}" />
                                        <TextBlock FontWeight="SemiBold" Text="许可证与隐私" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="第一方源码采用 Apache License 2.0；第三方组件与素材适用各自许可证。诊断信息遵循最少必要和严格脱敏原则。" />
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
        <Border Width="360"
                MaxHeight="160"
                Margin="0,0,24,92"
                Padding="14,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="900"
                Background="{DynamicResource PopoverBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.Name="Sonner 消息通知"
                AutomationProperties.LiveSetting="Polite">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  Opacity="0.42"
                                  ShadowDepth="6"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8"
                         Height="8"
                         Margin="0,5,10,0"
                         VerticalAlignment="Top">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource RingBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Success">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Warning">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NotificationKind}" Value="Error">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="提示" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationKind}" Value="Success">
                                        <Setter Property="Text" Value="操作成功" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationKind}" Value="Warning">
                                        <Setter Property="Text" Value="需要注意" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NotificationKind}" Value="Error">
                                        <Setter Property="Text" Value="操作失败" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="12"
                               Text="{Binding NotificationMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="DialogLightbox"
                Panel.ZIndex="1000"
                Background="#99000000"
                Visibility="Collapsed"
                Focusable="False"
                IsHitTestVisible="True"
                AutomationProperties.Name="对话框灯箱背景" />
    </Grid>
</Window>
